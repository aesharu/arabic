// Cloudflare Workers config.
// The site is plain static files in ./public, served directly. Only /api/* runs the small Worker in
// worker/index.js, which saves progress to the D1 database. "name" must match the Worker in the dashboard.
// The cloud-save key is a secret (SYNC_KEY) set with `wrangler secret put SYNC_KEY` — never in this file.
{
  "name": "arabic",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "arabic-db",
      "database_id": "9dabf8c3-df36-420a-8775-d1a745e0d9d5"
    }
  ]
}
